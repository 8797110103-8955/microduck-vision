{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "microduck-vision",
  "version": "0.1.0",
  "identifier": "microduck-vision",
  "build": {
    "beforeDevCommand": "cargo run --manifest-path src-tauri/Cargo.toml --bin generate-types && pnpm exec vite",
    "beforeBuildCommand": "cargo run --manifest-path src-tauri/Cargo.toml --bin generate-types && pnpm exec vite build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "microduck-vision",
        "width": 1280,
        "height": 820,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../assets/icons/icon.ico", "../assets/icons/icon.icns"]
  }
}
